# Server settings. The server reads these from the process environment and does not load this
# file itself, so export them or use your service manager's env-file support.
# Copy to .env (git-ignored). Never commit a real token.

# Default is 0.0.0.0:8787 (every local IPv4 address). Use 127.0.0.1:8787 behind a TLS proxy.
SYNTH_RC_BIND=127.0.0.1:8787
# Set one of these. Generate with: openssl rand -hex 32
SYNTH_RC_TOKEN=
# SYNTH_RC_TOKEN_FILE=/path/to/token
SYNTH_RC_OWNER_NAME=Owner
# reader (watch only), executor, or full
SYNTH_RC_VIEWER_ROLE=full
SYNTH_RC_MAX_SESSION_MIB=256
SYNTH_RC_RECONNECT_GRACE_MINUTES=10

# Client settings. Set these where Synth Warp launches, not on the server.
# SYNTH_WARP_REMOTE_CONTROL_URL=wss://rc.example.com
# SYNTH_WARP_REMOTE_CONTROL_TOKEN=
# SYNTH_WARP_REMOTE_CONTROL_ALL_TERMINALS=1
# SYNTH_WARP_REMOTE_CONTROL_HOST_LABEL=work laptop
